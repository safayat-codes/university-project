void decimalToBinary(int n){

    int binary[50],i=0;

    if(n==0){

        printf("Binary = 0\n");

        return;
    }

    while(n>0){

        binary[i++]=n%2;

        n/=2;
    }

    printf("Binary = ");

    for(int j=i-1;j>=0;j--)
        printf("%d",binary[j]);

    printf("\n");
}



void decimalToOctal(int n){

    printf("Octal = %o\n",n);
}



void decimalToHex(int n){

    printf("Hexadecimal = %X\n",n);
}



double baseToDecimal(char num[], int base){

    double result=0;

    int i=0;

    while(num[i]){

        int value;

        if(num[i]>='0' && num[i]<='9')
            value=num[i]-'0';

        else if(num[i]>='A' && num[i]<='F')
            value=num[i]-'A'+10;

        else if(num[i]>='a' && num[i]<='f')
            value=num[i]-'a'+10;

        else{

            printf("Invalid input\n");

            return -1;
        }

        if(value>=base){

            printf("Invalid input\n");

            return -1;
        }

        result=result*base+value;

        i++;
    }

    return result;
}



void numberSystemFunction(){

    int choice;

    char num[50],entry[200];

    int decimalValue;

    printf("\n--- NUMBER SYSTEM CONVERTER ---\n");

    printf("1.Binary\n2.Decimal\n3.Octal\n4.Hexadecimal\n");

    printf("Enter the number system of your input: ");

    choice=getInt();

    printf("Enter the number: ");

    scanf("%s",num);

    switch(choice){

        case 1:

            decimalValue=(int)baseToDecimal(num,2);

            if(decimalValue==-1)
                return;

            printf("Decimal = %d\n",decimalValue);

            printf("Octal = %o\n",decimalValue);

            printf("Hexadecimal = %X\n",decimalValue);

            sprintf(entry,"Binary %s converted",num);

            addHistory(entry);

            break;


        case 2:

            decimalValue=atoi(num);

            decimalToBinary(decimalValue);

            decimalToOctal(decimalValue);

            decimalToHex(decimalValue);

            sprintf(entry,"Decimal %s converted",num);

            addHistory(entry);

            break;


        case 3:

            decimalValue=(int)baseToDecimal(num,8);

            if(decimalValue==-1)
                return;

            decimalToBinary(decimalValue);

            printf("Decimal = %d\n",decimalValue);

            printf("Hexadecimal = %X\n",decimalValue);

            sprintf(entry,"Octal %s converted",num);

            addHistory(entry);

            break;


        case 4:

            decimalValue=(int)baseToDecimal(num,16);

            if(decimalValue==-1)
                return;

            decimalToBinary(decimalValue);

            printf("Decimal = %d\n",decimalValue);

            printf("Octal = %o\n",decimalValue);

            sprintf(entry,"Hexadecimal %s converted",num);

            addHistory(entry);

            break;


        default:

            printf("Invalid choice\n");
    }
}



void polynomialFunction(){

    double a,b,c,d;

    char entry[200];

    printf("Enter a b c: ");

    a=getDouble();
    b=getDouble();
    c=getDouble();

    d=b*b-4*a*c;

    if(d>=0){

        double r1=(-b+sqrt(d))/(2*a);
        double r2=(-b-sqrt(d))/(2*a);

        printf("Roots: %.2lf %.2lf\n",r1,r2);

        sprintf(entry,"Roots of %.2lfx^2+%.2lfx+%.2lf = %.2lf , %.2lf",a,b,c,r1,r2);
    }

    else{

        printf("Complex roots\n");

        sprintf(entry,"Complex roots for %.2lfx^2+%.2lfx+%.2lf",a,b,c);
    }

    addHistory(entry);
}



