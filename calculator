int getInt(){
    int x;

    while(scanf("%d",&x)!=1){
        printf("Invalid input: ");

        while(getchar()!='\n');
    }

    return x;
}

double getDouble(){

    double x;

    while(scanf("%lf",&x)!=1){

        printf("Invalid input: ");

        while(getchar()!='\n');
    }

    return x;
}

#define MAX_HISTORY 200

char history[MAX_HISTORY][200];

int historyCount=0;

void addHistory(char s[]){

    if(historyCount < MAX_HISTORY)
        strcpy(history[historyCount++], s);
}

void showHistory(){

    if(historyCount==0){

        printf("\nNo history available.\n");

        return;
    }

    printf("\n--- History ---\n");

    for(int i=0;i<historyCount;i++)
        printf("%d. %s\n",i+1,history[i]);
}

void clearHistory(){

    historyCount=0;

    printf("History cleared!\n");
}



