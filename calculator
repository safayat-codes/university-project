int determinant(int matrix[MAX][MAX], int n){

    if(n==1)
        return matrix[0][0];

    if(n==2)
        return matrix[0][0]*matrix[1][1]-matrix[0][1]*matrix[1][0];

    int temp[MAX][MAX],det=0,sign=1;

    for(int x=0;x<n;x++){

        int subi=0;

        for(int i=1;i<n;i++){

            int subj=0;

            for(int j=0;j<n;j++){

                if(j==x)
                    continue;

                temp[subi][subj++]=matrix[i][j];
            }

            subi++;
        }

        det+=sign*matrix[0][x]*determinant(temp,n-1);

        sign=-sign;
    }

    return det;
}



void matrixAddition(){

    int r1,c1,r2,c2;

    int A[4][4],B[4][4],C[4][4];

    char entry[200];

    printf("Enter rows and columns of first matrix: ");

    r1=getInt();
    c1=getInt();

    printf("Enter rows and columns of second matrix: ");

    r2=getInt();
    c2=getInt();

    if(r1>4 || c1>4 || r2>4 || c2>4 || r1!=r2 || c1!=c2){

        printf("Error\n");

        return;
    }

    printf("Enter first matrix:\n");

    for(int i=0;i<r1;i++)
        for(int j=0;j<c1;j++){

            printf("a%d%d = ",i+1,j+1);

            A[i][j]=getInt();
        }

    printf("Enter second matrix:\n");

    for(int i=0;i<r2;i++)
        for(int j=0;j<c2;j++){

            printf("b%d%d = ",i+1,j+1);

            B[i][j]=getInt();
        }

    printf("Result:\n");

    for(int i=0;i<r1;i++){

        for(int j=0;j<c1;j++){

            C[i][j]=A[i][j]+B[i][j];

            printf("%d ",C[i][j]);
        }

        printf("\n");
    }

    sprintf(entry,"Matrix addition performed");

    addHistory(entry);
}



void matrixMultiplication(){

    int r1,c1,r2,c2;

    int A[4][4],B[4][4],C[4][4];

    char entry[200];

    printf("Enter rows and columns of first matrix: ");

    r1=getInt();
    c1=getInt();

    printf("Enter rows and columns of second matrix: ");

    r2=getInt();
    c2=getInt();

    if(r1>4 || c1>4 || r2>4 || c2>4 || c1!=r2){

        printf("Error\n");

        return;
    }

    printf("Enter first matrix:\n");

    for(int i=0;i<r1;i++)
        for(int j=0;j<c1;j++){

            printf("a%d%d = ",i+1,j+1);

            A[i][j]=getInt();
        }

    printf("Enter second matrix:\n");

    for(int i=0;i<r2;i++)
        for(int j=0;j<c2;j++){

            printf("b%d%d = ",i+1,j+1);

            B[i][j]=getInt();
        }

    for(int i=0;i<r1;i++){

        for(int j=0;j<c2;j++){

            C[i][j]=0;

            for(int k=0;k<c1;k++)
                C[i][j]+=A[i][k]*B[k][j];
        }
    }

    printf("Result:\n");

    for(int i=0;i<r1;i++){

        for(int j=0;j<c2;j++)
            printf("%d ",C[i][j]);

        printf("\n");
    }

    sprintf(entry,"Matrix multiplication performed");

    addHistory(entry);
}



